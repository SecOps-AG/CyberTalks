{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Workers Paid. The incremental-cache bucket already exists in this account.
  "account_id": "46d1c096a70866c4b05e8842743afd6e",
  "name": "cybertalks",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cybertalks"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "cybertalks-opennext-cache"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://cyber-talks.vercel.app"
  }
}
