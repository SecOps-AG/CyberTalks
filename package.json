{
  "name": "cybertalks",
  "version": "1.0.0",
  "private": true,
  "description": "Searchable archive of cybersecurity conference talks, with video and written summaries.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate && npm run generate-shards && next build",
    "start": "next start",
    "validate": "node scripts/validate-data.mjs && node scripts/check-defcon-villages.mjs",
    "generate-shards": "node scripts/generate-summary-shards.mjs && node scripts/generate-talk-index-shards.mjs && tsx scripts/generate-catalog-shards.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "topics": "node scripts/list-topics.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@vercel/analytics": "^2.0.1",
    "next": "^15.5.27",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "wrangler": "^4.147.0"
  }
}
