# dependencies
node_modules
.pnp
.pnp.js

# next
.next
out
.open-next
.wrangler

# generated catalog shards (rebuilt by generate-shards)
public/catalog

# summary shards are derived from data/villages on each build
public/data/summaries/

# wrangler local vars — copy .dev.vars.example if you need them
.dev.vars
.dev.vars.*
!.dev.vars.example

# env — every variant, so a stray .env.production cannot be committed
.env*
!.env.example

# debug / os
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.pem

# typescript
next-env.d.ts
*.tsbuildinfo

# raw yt-dlp dumps (local only)
data/raw
